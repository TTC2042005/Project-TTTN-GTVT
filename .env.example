# Copy this file to .env and replace placeholders with private local values.
# Never commit .env or put production credentials in this template.
JWT_SECRET=replace-with-a-long-random-private-secret
DATABASE_URL=postgres://film_lab_user:film_lab_pass@localhost:5432/film_lab_db
FRONTEND_URL=http://localhost:3000

# Optional integrations (leave blank for local fallback behavior)
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
