@startuml SD_ProjectOverview
title Sequence tong quan - Film Lab Ecosystem
autonumber
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Nguoi dung" as User
boundary "Giao dien\nNext.js" as UI
control "Backend API\nExpress" as API
database "PostgreSQL" as DB
participant "OAuth\nGoogle/Facebook*" as OAuth
participant "Stripe*" as Stripe
participant "Luu tru tep\nLocal/S3*" as Storage
participant "Dich vu AI\nOpenAI/Gemini*" as AI

== Dang nhap ==
User -> UI: Chon phuong thuc dang nhap
alt Email va mat khau
  UI -> API: Gui thong tin dang nhap
  API -> DB: Tim tai khoan
  DB --> API: Thong tin tai khoan
  API -> API: Kiem tra mat khau, tao JWT
else Google/Facebook*
  UI -> API: Bat dau OAuth
  API -> OAuth: Chuyen huong xac thuc
  OAuth --> API: Callback code va state
  API -> OAuth: Doi code lay profile
  OAuth --> API: Thong tin tai khoan
  API -> DB: Tim hoac tao tai khoan
  DB --> API: Tai khoan
end
API --> UI: Tra ket qua dang nhap va JWT
UI --> User: Hien thi trang chinh

== Nguoi dung chon mot nghiep vu ==
alt Dat dich vu Film Lab
  User -> UI: Tim lab va chon dich vu
  UI -> API: Lay danh sach Film Lab
  API -> DB: Doc lab, dich vu va goi
  DB --> API: Danh sach Film Lab
  User -> UI: Gui yeu cau dat dich vu
  UI -> API: Tao don hang
  API -> DB: Luu orders, order_items
  DB --> API: Don hang
  alt Thanh toan Stripe*
    API -> Stripe: Tao phien checkout
    Stripe --> API: Link thanh toan
    API --> UI: Tra link thanh toan
    Stripe -> API: Gui ket qua thanh toan
    API -> DB: Cap nhat giao dich va don hang
  else Thanh toan Bank QR
    API --> UI: Tra thong tin QR
    User -> UI: Gui minh chung thanh toan
    UI -> API: Upload minh chung va xac nhan
    API -> Storage: Luu tep minh chung
    Storage --> API: Thong tin tep
    API -> DB: Luu minh chung, cho xac nhan
  end
  API --> UI: Tra trang thai don hang
else Marketplace
  User -> UI: Xem san pham
  UI -> API: Lay danh sach san pham
  API -> DB: Doc products
  DB --> API: Danh sach san pham
  alt Yeu thich san pham
    User -> UI: Chon yeu thich
    UI -> API: Cap nhat favorites
    API -> DB: Luu favorites
  else Dat mua san pham
    User -> UI: Chon san pham va so luong
    UI -> API: Tao don Marketplace
    API -> DB: Kiem tra ton kho, tao don, tru kho
    DB --> API: Don hang
    opt Gui minh chung thanh toan
      UI -> API: Upload minh chung
      API -> Storage: Luu tep minh chung
      Storage --> API: Thong tin tep
      API -> DB: Lien ket tep voi don hang
    end
  end
  API --> UI: Tra ket qua Marketplace
else Cong dong va su kien
  alt Dang bai
    User -> UI: Soan bai viet
    opt Dinh kem toi da 5 anh
      UI -> API: Upload anh
      API -> Storage: Luu anh
      Storage --> API: Thong tin tep
      API -> DB: Luu uploads
      DB --> API: Ma anh
    end
    UI -> API: Tao bai viet kem noi dung / ma anh
    API -> DB: Luu posts
  else Binh luan hoac nhan tin
    User -> UI: Gui binh luan / tin nhan
    UI -> API: Gui noi dung
    API -> DB: Luu comments / messages
  else Dang ky workshop / photowalk
    User -> UI: Chon su kien
    UI -> API: Gui yeu cau dang ky
    API -> DB: Kiem tra su kien, cho va luu dang ky
  end
  DB --> API: Ket qua
  API --> UI: Hien thi ket qua
else Hinh anh va AI
  alt Nhan xet hinh anh
    User -> UI: Tai anh len
    UI -> API: Gui tep anh
    API -> API: Tinh chi so chat luong anh
    API -> Storage: Luu anh
    Storage --> API: Thong tin tep
    API -> DB: Luu uploads va quality
    User -> UI: Yeu cau nhan xet, tuy chon dong y AI
    UI -> API: Gui yeu cau review
    alt Da dong y va OpenAI duoc cau hinh*
      API -> Storage: Doc anh da luu
      Storage --> API: Du lieu anh
      API -> AI: Phan tich anh
      AI --> API: Nhan xet
    else Khong dong y hoac chua cau hinh AI
      API -> API: Tao nhan xet tu chi so chat luong
    end
  else Chatbot hoi dap
    User -> UI: Nhap cau hoi
    UI -> API: Gui cau hoi
    API -> DB: Tim du lieu va tai lieu lien quan
    DB --> API: Ngu canh
    alt AI duoc cau hinh*
      API -> AI: Tao cau tra loi tu ngu canh
      AI --> API: Cau tra loi
    else Khong co AI
      API -> API: Tao cau tra loi tu du lieu noi bo
    end
  end
  API --> UI: Tra ket qua phan tich / hoi dap
  UI --> User: Hien thi ket qua
end

note over User, DB
  Moi nhanh la mot nghiep vu doc lap sau khi dang nhap.
  Cac dich vu co dau * la ket noi ben ngoai tuy cau hinh.
end note

@enduml
