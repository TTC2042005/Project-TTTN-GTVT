@startuml FilmLab_Ecosystem_ERD
title ERD tổng quát - Film Lab Ecosystem
left to right direction
hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor #F4F7F5
  BorderColor #2D6B65
  FontColor #24343A
}
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #C8953D
  FontColor #24343A
}

entity "users" as users {
  * id : UUID <<PK>>
  --
  email : TEXT <<UNIQUE>>
  role : user_role_enum
  google_id : TEXT (optional)
  facebook_id : TEXT (optional)
}

package "Film Lab và đơn hàng" {
  entity "film_labs" as film_labs {
    * id : UUID <<PK>>
    --
    owner_id : UUID <<FK>>
    name : TEXT
  }

  entity "lab_services" as lab_services {
    * id : UUID <<PK>>
    --
    lab_id : UUID <<FK>>
    name : TEXT
    price : REAL
  }

  entity "lab_packages" as lab_packages {
    * id : UUID <<PK>>
    --
    lab_id : UUID <<FK>>
    title : TEXT
    price : REAL
  }

  entity "orders" as orders {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    lab_id : UUID <<FK>>
    status : order_status_enum
    total_price : REAL
  }

  entity "order_items" as order_items {
    * id : UUID <<PK>>
    --
    order_id : UUID <<FK>>
    item_type : TEXT
    item_id : UUID
    quantity : INTEGER
  }

  entity "transactions" as transactions {
    * id : UUID <<PK>>
    --
    order_id : UUID <<FK, nullable>>
    verified_by : UUID <<FK, nullable>>
    amount : REAL
    status : transaction_status_enum
  }
}

package "Marketplace" {
  entity "products" as products {
    * id : UUID <<PK>>
    --
    seller_id : UUID <<FK>>
    title : TEXT
    price : REAL
    stock : INTEGER
  }

  entity "favorites" as favorites {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    product_id : UUID <<FK>>
  }

  entity "marketplace_orders" as marketplace_orders {
    * id : UUID <<PK>>
    --
    buyer_id : UUID <<FK>>
    seller_id : UUID <<FK>>
    product_id : UUID <<FK>>
    proof_upload_id : UUID <<FK, nullable>>
    status : marketplace_order_status_enum
  }

  entity "reviews" as reviews {
    * id : UUID <<PK>>
    --
    author_id : UUID <<FK>>
    target_type : TEXT
    target_id : UUID
    rating : INTEGER
  }
}

package "Community và nội dung" {
  entity "posts" as posts {
    * id : UUID <<PK>>
    --
    author_id : UUID <<FK>>
    title : TEXT
    image_urls : TEXT[]
    visibility : post_visibility_enum
  }

  entity "comments" as comments {
    * id : UUID <<PK>>
    --
    post_id : UUID <<FK>>
    author_id : UUID <<FK>>
    content : TEXT
  }

  entity "messages" as messages {
    * id : UUID <<PK>>
    --
    sender_id : UUID <<FK>>
    recipient_id : UUID <<FK>>
    content : TEXT
  }

  entity "content_reports" as content_reports {
    * id : UUID <<PK>>
    --
    reporter_id : UUID <<FK>>
    target_type : content_report_target_enum
    target_id : UUID
    status : content_report_status_enum
  }
}

package "Sự kiện và ảnh" {
  entity "workshops" as workshops {
    * id : UUID <<PK>>
    --
    organizer_id : UUID <<FK>>
    title : TEXT
    event_date : TIMESTAMPTZ
  }

  entity "photowalks" as photowalks {
    * id : UUID <<PK>>
    --
    organizer_id : UUID <<FK>>
    title : TEXT
    event_date : TIMESTAMPTZ
  }

  entity "event_registrations" as event_registrations {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    event_type : event_registration_type_enum
    event_id : UUID
  }

  entity "film_screenings" as film_screenings {
    * id : UUID <<PK>>
    --
    film_title : TEXT
    event_date : TIMESTAMPTZ
    capacity : INTEGER
  }

  entity "ticket_reservations" as ticket_reservations {
    * id : UUID <<PK>>
    --
    screening_id : UUID <<FK>>
    user_id : UUID <<FK>>
    quantity : INTEGER
    status : ticket_reservation_status_enum
  }

  entity "uploads" as uploads {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    filename : TEXT
    url : TEXT
    metadata : JSONB
  }
}

package "AI và quản trị" {
  entity "rag_documents" as rag_documents {
    * id : UUID <<PK>>
    --
    source : TEXT
    content : TEXT
    metadata : JSONB
    embedding : JSONB
  }

  entity "admin_audit_logs" as admin_audit_logs {
    * id : UUID <<PK>>
    --
    actor_id : UUID <<FK>>
    action : TEXT
    entity_type : TEXT
    details : JSONB
  }
}

users "1" -- "0..*" film_labs : owns
film_labs "1" -- "0..*" lab_services : provides
film_labs "1" -- "0..*" lab_packages : offers
users "1" -- "0..*" orders : places
film_labs "1" -- "0..*" orders : receives
orders "1" -- "0..*" order_items : contains
orders "0..1" -- "0..*" transactions : paid by
users "0..1" -- "0..*" transactions : verifies

users "1" -- "0..*" products : sells
users "1" -- "0..*" favorites : saves
products "1" -- "0..*" favorites : favorited
users "1" -- "0..*" marketplace_orders : buys
users "1" -- "0..*" marketplace_orders : sells
products "1" -- "0..*" marketplace_orders : ordered
uploads "0..1" -- "0..*" marketplace_orders : payment proof
users "1" -- "0..*" reviews : writes

users "1" -- "0..*" posts : authors
posts "1" -- "0..*" comments : has
users "1" -- "0..*" comments : writes
users "1" -- "0..*" messages : sends
users "1" -- "0..*" messages : receives
users "1" -- "0..*" content_reports : reports

users "1" -- "0..*" workshops : organizes
users "1" -- "0..*" photowalks : organizes
users "1" -- "0..*" event_registrations : registers
film_screenings "1" -- "0..*" ticket_reservations : has
users "1" -- "0..*" ticket_reservations : reserves
users "1" -- "0..*" uploads : owns
users "1" -- "0..*" admin_audit_logs : performs

note bottom of order_items
  item_type + item_id trỏ tới service hoặc package,
  nhưng item_id không có FK trực tiếp.
end note

note bottom of event_registrations
  event_type + event_id trỏ tới workshop hoặc photowalk,
  nhưng event_id không có FK trực tiếp.
end note

note bottom of posts
  image_urls lưu URL ảnh, không phải FK tới uploads.
end note

note bottom of reviews
  target_type + target_id là quan hệ đa hình,
  không có FK trực tiếp tới đối tượng được đánh giá.
end note

note bottom of content_reports
  target_type + target_id là quan hệ đa hình,
  không có FK trực tiếp tới nội dung bị báo cáo.
end note

note bottom of rag_documents
  RAG documents không có FK tới bảng nghiệp vụ.
  Ảnh được lưu ở local/S3; DB chỉ giữ metadata và URL.
end note

@enduml
