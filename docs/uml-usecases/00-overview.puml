@startuml
title Use Case tổng quan
left to right direction
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 35

actor "Khách" as Guest
actor "Photographer" as Photographer
actor "Lab Owner / Seller" as Business
actor "Admin" as Admin

rectangle "Film Lab Ecosystem" {
  usecase "Đăng ký /\nđăng nhập" as Account
  usecase "Tìm Film Lab /\nsản phẩm" as Browse
  usecase "Đặt dịch vụ /\nmua hàng" as Order
  usecase "Đăng bài /\ntham gia sự kiện" as Community
  usecase "Sử dụng công cụ AI" as AI
  usecase "Quản lý Film Lab /\nsản phẩm" as ManageBusiness
  usecase "Quản trị hệ thống" as Administer
}

Guest -right-> Account
Guest -right-> Browse

Photographer -right-> Browse
Photographer -right-> Order
Photographer -right-> Community
Photographer -right-> AI

Business -right-> ManageBusiness
Admin -right-> Administer

@enduml
